# Copiez ce fichier en ".env" et renseignez vos valeurs.
# NE PUBLIEZ JAMAIS le fichier .env sur GitHub (il est deja dans .gitignore).

# --- Serveur ---
# NODE_ENV=production active la securite maximale :
#   cookie "Secure", en-tete HSTS, ecoute sur toutes les interfaces
NODE_ENV=production
PORT=3000

# 127.0.0.1 = uniquement cet ordinateur (developpement)
# 0.0.0.0   = accessible par le reseau / Internet (production)
HOST=0.0.0.0

# --- Premier administrateur ---
# Utilise UNIQUEMENT au tout premier demarrage, sur une base vide.
# Cree le compte, puis SUPPRIMEZ ces deux lignes de votre .env.
# Si laisse vide, un mot de passe aleatoire est affiche dans la console.
ADMIN_USER=admin
ADMIN_PASSWORD=ChangezMoi123!

# --- Base de donnees ---
# Chemin du fichier SQLite. Sur un disque persistant, gardez un chemin
# absolu pour etre sur que les donnees survivent aux redéploiements.
# DATA_DIR=/var/lib/comptabilite
# COMPA_DB=/var/lib/comptabilite/compta.db

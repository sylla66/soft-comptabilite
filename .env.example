# Chaine de connexion PostgreSQL.
#
# En production (Neon) : copiez la chaine "pooled" depuis le tableau de bord
# Neon (Connection Details > Direct / Pooled). Elle contient sslmode=require.
# DATABASE_URL=postgresql://user:motdepasse@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# En local (conteneur Docker de test) :
# DATABASE_URL=postgresql://compta:secret_test@127.0.0.1:5433/compta_test

DATABASE_URL=

# PORT et HOST ne sont normally pas necessaires ; Render les fournit.
# PORT=3000
# HOST=0.0.0.0

# Premier administrateur cree au tout premier demarrage sur une base vide.
# ADMIN_PASSWORD est facultatif : sans lui, un mot de passe aleatoire est
# affiche dans les logs au demarrage. Dans les deux cas, un changement de mot
# de passe est impose a la premiere connexion.
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# Comptes de test, crees par `npm run seed`. Rien n'est ecrase si le compte
# existe deja. Les mots de passe ne sont affiches qu'une fois, dans le terminal.
# SEED_ADMIN_NOM=admin
# SEED_ADMIN_MDP=
# SEED_SAISIE_NOM=saisie
# SEED_SAISIE_MDP=
